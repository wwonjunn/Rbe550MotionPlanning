<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="ball">
    <static>false</static>
    <link name="ball_link">
    
      <!-- Pose: X Y Z Roll Pitch Yaw -->
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>.056</mass>
        <!-- Inertia tensor for a solid sphere: I = 2/5 * m * r^2 Radius = .03m-->
        <inertia>
          <ixx>0.00002</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0.0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>

      <collision name="ball_collision">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.6</restitution_coefficient>
            <threshold>0.0</threshold>
          </bounce>
        </surface>
      </collision>

      <!-- Visual appearance in the simulator -->
      <visual name="ball_visual">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.8 0.9 0.1 1</ambient>
          <diffuse>0.8 0.9 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>ball_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
