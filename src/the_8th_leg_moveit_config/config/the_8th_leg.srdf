<?xml version="1.0" encoding="UTF-8"?>
<robot name="the_8th_leg">
    <group name="arm">
        <chain base_link="base_link" tip_link="link_7"/>
    </group>
   
    <group_state name="home" group="arm">
        <joint name="base_yaw_joint" value="0"/>
        <joint name="elbow_pitch_joint" value="1"/>
        <joint name="shoulder_pitch_joint" value="0.4"/>
        <joint name="wrist_pitch_joint" value="0.6"/>
        <joint name="wrist_roll_joint" value="0"/>
        <joint name="wrist_yaw_joint" value="0"/>
    </group_state>
    <group_state name="goal_a" group="arm">
        <joint name="base_yaw_joint" value="1.2"/>
        <joint name="shoulder_pitch_joint" value="0.8"/>
        <joint name="elbow_pitch_joint" value="0.6"/>
        <joint name="wrist_pitch_joint" value="0.4"/>
        <joint name="wrist_roll_joint" value="0"/>
        <joint name="wrist_yaw_joint" value="0"/>
    </group_state>

    <disable_collisions link1="base_link" link2="link_2" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="link_3" reason="Never"/>
    <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
    <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
    <disable_collisions link1="link_3" link2="link_5" reason="Never"/>
    <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
    <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
    <disable_collisions link1="link_5" link2="link_7" reason="Never"/>
    <disable_collisions link1="link_6" link2="link_7" reason="Adjacent"/>
</robot>
