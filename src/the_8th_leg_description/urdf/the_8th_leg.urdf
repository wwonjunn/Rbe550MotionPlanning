<?xml version="1.0"?>
<robot name="the_8th_leg">

    <!-- Colors so you can actually see the joints rotate -->
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
    </material>
    <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
    </material>
    <material name="blue">
        <color rgba="0.2 0.4 0.9 1.0"/>
    </material>

    <!-- World link-->
    <link name="world"/>

    <!-- ROOT/Link 1 -->
    <!-- mass=0.1kg, r=0.1m, h=0.02m -->
    <!-- ixx=iyy=(1/12)*0.1*(3*0.01+0.0004)=0.000253 -->
    <!-- izz=(1/2)*0.1*0.01=0.0005 -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.01"/>
            <geometry>
                <cylinder radius="0.1" length="0.02"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.01"/>
            <geometry>
                <cylinder radius="0.1" length="0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.01"/>
            <mass value="0.1"/>
            <inertia ixx="0.000253" iyy="0.000253" izz="0.0005"
                     ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <!-- Link 2: Upper arm / shoulder segment -->
    <!-- mass=1.0kg, r=0.05m, h=0.09m -->
    <!-- ixx=iyy=(1/12)*1.0*(3*0.0025+0.0081)=0.0013 -->
    <!-- izz=(1/2)*1.0*0.0025=0.00125 -->
    <link name="link_2">
        <visual>
            <origin xyz="0 0 0.045"/>
            <geometry>
                <cylinder radius="0.05" length="0.09"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.045"/>
            <geometry>
                <cylinder radius="0.05" length="0.09"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.045"/>
            <mass value="1.0"/>
            <inertia ixx="0.0013" iyy="0.0013" izz="0.00125"
                     ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <!-- Link 3: Shoulder to elbow -->
    <!-- mass=1.0kg, r=0.04m, h=0.2m -->
    <!-- ixx=iyy=(1/12)*1.0*(3*0.0016+0.04)=0.003733 -->
    <!-- izz=(1/2)*1.0*0.0016=0.0008 -->
    <link name="link_3">
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.04" length="0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.04" length="0.2"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.1"/>
            <mass value="1.0"/>
            <inertia ixx="0.003733" iyy="0.003733" izz="0.0008"
                     ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <!-- Link 4: Elbow to wrist -->
    <!-- mass=1.0kg, r=0.035m, h=0.2m -->
    <!-- ixx=iyy=(1/12)*1.0*(3*0.001225+0.04)=0.00364 -->
    <!-- izz=(1/2)*1.0*0.001225=0.000613 -->
    <link name="link_4">
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.035" length="0.2"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.035" length="0.2"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.1"/>
            <mass value="1.0"/>
            <inertia ixx="0.00364" iyy="0.00364" izz="0.000613"
                     ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <!-- Link 5: Wrist pitch segment -->
    <!-- mass=1.0kg, r=0.03m, h=0.05m -->
    <!-- ixx=iyy=(1/12)*1.0*(3*0.0009+0.0025)=0.000433 -->
    <!-- izz=(1/2)*1.0*0.0009=0.00045 -->
    <link name="link_5">
        <visual>
            <origin xyz="0 0 0.025"/>
            <geometry>
                <cylinder radius="0.03" length="0.05"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.025"/>
            <geometry>
                <cylinder radius="0.03" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.025"/>
            <mass value="1.0"/>
            <inertia ixx="0.000433" iyy="0.000433" izz="0.00045"
                     ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <!-- Link 6: Wrist roll segment -->
    <!-- mass=1.0kg, r=0.03m, h=0.04m -->
    <!-- ixx=iyy=(1/12)*1.0*(3*0.0009+0.0016)=0.000358 -->
    <!-- izz=(1/2)*1.0*0.0009=0.00045 -->
    <link name="link_6">
        <visual>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <cylinder radius="0.03" length="0.04"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <cylinder radius="0.03" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.02"/>
            <mass value="1.0"/>
            <inertia ixx="0.000358" iyy="0.000358" izz="0.00045"
                     ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <!-- Link 7: Wrist yaw / tool segment -->
    <!-- mass=1.0kg, r=0.025m, h=0.04m -->
    <!-- ixx=iyy=(1/12)*1.0*(3*0.000625+0.0016)=0.00029 -->
    <!-- izz=(1/2)*1.0*0.000625=0.000313 -->
    <link name="link_7">
        <visual>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <cylinder radius="0.025" length="0.04"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <cylinder radius="0.025" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.02"/>
            <mass value="1.0"/>
            <inertia ixx="0.00029" iyy="0.00029" izz="0.000313"
                     ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>


    <!-- Joint 0 : World link to Base link-->
    <joint name="world_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0"/>
    </joint>

    <!-- JOINT 1 : Base yaw, CCW from above -->
    <joint name="base_rotate_joint" type="revolute">
        <parent link="base_link"/>
        <child link="link_2"/>
        <origin xyz="0 0 0.02"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159"
               effort="10.0" velocity="1.0"/>
    </joint>

    <!-- JOINT 2 : Shoulder pitch, + tips forward toward +X (-108 to +114 deg) -->
    <joint name="base_to_shoulder" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 0.09"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.88496" upper="1.98968"
               effort="10.0" velocity="1.0"/>
    </joint>

    <!-- JOINT 3 : Elbow pitch, + folds forward toward +X (-33 to +150 deg) -->
    <joint name="shoulder_to_elbow" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0 0.2"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.57596" upper="2.61799"
               effort="10.0" velocity="1.0"/>
    </joint>

    <!-- JOINT 4 : Wrist pitch, + tips forward toward +X (-100 to +123 deg) -->
    <joint name="elbow_to_wrist_pitch" type="revolute">
        <parent link="link_4"/>
        <child link="link_5"/>
        <origin xyz="0 0 0.2"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.74533" upper="2.14675"
               effort="10.0" velocity="1.0"/>
    </joint>

    <!-- JOINT 5 : Wrist roll, spins about its own long axis (full rotation ok) -->
    <joint name="wrist_pitch_to_roll" type="revolute">
        <parent link="link_5"/>
        <child link="link_6"/>
        <origin xyz="0 0 0.05"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159"
               effort="10.0" velocity="1.0"/>
    </joint>

    <!-- JOINT 6 : Wrist yaw, bends tool sideways, + toward -Y (-90 to +90 deg) -->
    <joint name="wrist_roll_to_yaw" type="revolute">
        <parent link="link_6"/>
        <child link="link_7"/>
        <origin xyz="0 0 0.04"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.57080" upper="1.57080"
               effort="10.0" velocity="1.0"/>
    </joint>
</robot>
